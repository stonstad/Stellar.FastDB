<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0; net9.0; net8.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Authors>Shaun Tonstad</Authors>
    <Title>Stellar.FastDB</Title>
    <Description>Stellar.FastDB is an embedded document store built for performance and high concurrency.</Description>
    <Copyright>Shaun Tonstad</Copyright>
    <PackageProjectUrl>https://github.com/stonstad/Stellar.FastDB</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeContentInPack>true</IncludeContentInPack>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Version>2.1.0</Version>
    <AssemblyVersion>2.1.0</AssemblyVersion>
    <FileVersion>2.1.0</FileVersion>
    </PropertyGroup>

  <!-- a package must never contain the test hooks (see Directory.Build.props) -->
  <PropertyGroup Condition="'$(FastDBTestHooks)' == 'true'">
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
  </PropertyGroup>

  <Target Name="RefusePackWithTestHooks" BeforeTargets="GenerateNuspec" Condition="'$(FastDBTestHooks)' == 'true'">
    <Error Text="Stellar.FastDB can't be packed with FASTDB_TEST_HOOKS defined. Pack a Release build." />
  </Target>

  <ItemGroup>
    <None Include="..\LICENSE" Link="LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md" Link="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Stellar.FastDB.Tests" />
  </ItemGroup>

</Project>
